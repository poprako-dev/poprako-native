{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "draft": true,
  "force-tag-creation": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "release-type": "node",
      "initial-version": "1.0.0",
      "extra-files": [
        "src-tauri/tauri.conf.json",
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'poprako-native')].version"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "新增", "hidden": false },
        { "type": "fix", "section": "修复", "hidden": false },
        { "type": "perf", "section": "性能改进", "hidden": false },
        { "type": "revert", "section": "回退", "hidden": false },
        { "type": "docs", "section": "文档", "hidden": true },
        { "type": "chore", "section": "维护", "hidden": true },
        { "type": "refactor", "section": "重构", "hidden": true },
        { "type": "test", "section": "测试", "hidden": true },
        { "type": "ci", "section": "构建", "hidden": true }
      ]
    }
  }
}
