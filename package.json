{
  "name": "poprako-native",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@tauri-apps/api": "2.11.1",
    "@tanstack/react-router": "1.170.39",
    "@radix-ui/react-dialog": "1.1.23",
    "lucide-react": "1.48.0",
    "zustand": "5.0.15",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/node": "26.6.2",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "@tauri-apps/cli": "2.11.5",
    "@tanstack/router-plugin": "1.168.40",
    "@tanstack/router-generator": "1.167.38",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "postcss": "8.5.28",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "typescript-eslint": "8.67.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "vitest": "4.1.7",
    "@testing-library/react": "16.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.1"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "node script/check-toolchain.ts && vite",
    "desktop": "pnpm run tauri dev",
    "tauri": "node script/check-toolchain.ts && tauri",
    "build": "node script/check-toolchain.ts && pnpm run typecheck && vite build",
    "typecheck": "node script/check-toolchain.ts && tsc --noEmit",
    "lint": "node script/check-toolchain.ts && eslint . --max-warnings 0",
    "test:frontend": "node script/check-toolchain.ts && vitest run",
    "test:rust": "node script/check-toolchain.ts && cargo test --manifest-path src-tauri/Cargo.toml --workspace --all-targets --locked",
    "test": "node script/check-toolchain.ts && pnpm run test:frontend && pnpm run test:rust",
    "format": "node script/check-toolchain.ts && prettier --write src script .github .release-please-manifest.json *.json *.ts *.mjs && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "node script/check-toolchain.ts && prettier --check src script .github .release-please-manifest.json *.json *.ts *.mjs && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "check": "node script/check-toolchain.ts && node script/check.ts",
    "generate": "node script/check-toolchain.ts && node script/generate.ts",
    "package": "pnpm run tauri build",
    "check:rust-style": "node script/check-toolchain.ts && cargo run --manifest-path src-tauri/Cargo.toml --locked -p poprako-style-check"
  }
}
