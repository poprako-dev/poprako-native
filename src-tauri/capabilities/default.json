{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main window commands and lifecycle events",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-select-images",
    "allow-select-image-folder",
    "allow-get-image-import",
    "allow-cancel-image-import",
    "allow-confirm-image-import",
    "allow-choose-archive-import",
    "allow-get-archive-task",
    "allow-cancel-archive-task",
    "allow-acknowledge-archive-task",
    "allow-confirm-archive-import",
    "allow-export-archive",
    "allow-reorder-pages",
    "allow-remove-pages",
    "allow-list-comic-infos",
    "allow-search-units",
    "allow-replace-units",
    "allow-get-comic-detail",
    "allow-create-comic",
    "allow-update-comic-metadata",
    "allow-delete-comic",
    "allow-get-page-editor",
    "allow-save-page-units",
    "allow-get-preference",
    "allow-get-default-preference",
    "allow-update-preference",
    "allow-update-work-position",
    "allow-get-image-resource",
    "allow-get-image-tile",
    "allow-release-image-resources",
    "allow-request-exit",
    "allow-get-write-session",
    "allow-get-write-result",
    "allow-acknowledge-write-result",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging"
  ]
}
